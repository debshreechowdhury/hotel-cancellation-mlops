# Copy to .env (git-ignored) and fill in. Never commit .env.
# Supabase -> Project Settings -> Data API (Project URL) / API Keys (secret key)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: set this instead of running `wandb login`
# WANDB_API_KEY=
